---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import {
  CATEGORY_BLURBS,
  SITE,
  categoryHref,
  collectTags,
  formatDate,
  getArticles,
  groupByCategory,
  tagHref,
} from '../lib/content';

const articles = await getArticles();
const groups = groupByCategory(articles);
const tags = collectTags(articles);
const latest = articles[0];
---

<Base title={SITE.name} description={SITE.description}>
  <div class="shell">
    <section class="hero" id="top">
      <p class="eyebrow">{SITE.tagline}</p>
      <h1>把复杂的事，讲到能站住。</h1>
      <p class="hero-lead">
        经济学、科技、人工智能。每篇从可靠材料出发，把机制拆开；背景知识和类比会单独标出来。
      </p>
      <dl class="stats">
        <div>
          <dt>文章</dt>
          <dd>{articles.length}</dd>
        </div>
        <div>
          <dt>分类</dt>
          <dd>{groups.length}</dd>
        </div>
        <div>
          <dt>最近</dt>
          <dd>{latest ? formatDate(latest.data.date) : '—'}</dd>
        </div>
      </dl>
    </section>

    {
      groups.length > 0 && (
        <nav class="filters" aria-label="按分类浏览">
          <span class="filters-label">分类</span>
          <a class="chip" href="#top">全部</a>
          {groups.map(([category]) => (
            <a class="chip" href={`#${category}`}>
              {category}
            </a>
          ))}
        </nav>
      )
    }

    {
      groups.length === 0 && (
        <p class="empty">还没有文章。在 <code>src/content/articles/</code> 放入一篇 Markdown 即可。</p>
      )
    }

    {
      groups.map(([category, items]) => (
        <section class="category-block" id={category} aria-labelledby={`heading-${category}`}>
          <header class="category-head">
            <div>
              <h2 class="category-name" id={`heading-${category}`}>
                <a href={categoryHref(category)}>{category}</a>
              </h2>
              {CATEGORY_BLURBS[category] && <p class="blurb">{CATEGORY_BLURBS[category]}</p>}
            </div>
            <a class="count-link" href={categoryHref(category)}>
              {items.length} 篇
            </a>
          </header>
          <ArticleList articles={items} />
        </section>
      ))
    }

    {
      tags.length > 0 && (
        <section class="tag-panel" aria-labelledby="tag-heading">
          <header class="panel-head">
            <h2 id="tag-heading">标签</h2>
          </header>
          <ul class="tag-cloud">
            {tags.map((tag) => (
              <li>
                <a href={tagHref(tag.name)}>
                  {tag.name}
                  <span>{tag.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
