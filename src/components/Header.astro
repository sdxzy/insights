---
import { categoryHref, withBase } from '../lib/content';

interface Props {
  categories: string[];
  activeCategory?: string;
  isHome?: boolean;
}

const { categories, activeCategory, isHome = false } = Astro.props;
const home = withBase();
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={home}>
      <span class="seal" aria-hidden="true">解</span>
      <span>
        <span class="brand-name">解读站</span>
        <span class="brand-en">Insights</span>
      </span>
    </a>
    <nav class="primary-nav" aria-label="分类">
      <a href={home} aria-current={isHome ? 'page' : undefined}>全部</a>
      {
        categories.map((category) => (
          <a
            href={categoryHref(category)}
            aria-current={activeCategory === category ? 'page' : undefined}
          >
            {category}
          </a>
        ))
      }
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换到深色模式" aria-pressed="false">
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M15.5 3.5a8.2 8.2 0 1 0 5 12.2A7 7 0 0 1 15.5 3.5z" stroke-linejoin="round"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="12" cy="12" r="3.2"></circle>
        <path d="M12 3.5v1.8M12 18.7v1.8M4.8 12H3M21 12h-1.8M6.4 6.4 5.1 5.1M18.9 18.9l-1.3-1.3M17.6 6.4l1.3-1.3M5.1 18.9l1.3-1.3" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>
